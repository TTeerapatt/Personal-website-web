# Browser-facing API base URL. Baked into the bundle at build time.
# Must include the API prefix and a trailing slash.
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001/personal-website/api/

# Optional. Used only during server rendering, for when the API is reachable at
# a different address than the browser uses (e.g. a Docker service name).
# Falls back to NEXT_PUBLIC_BACKEND_URL when unset.
# BACKEND_INTERNAL_URL=http://personal-website-api:3001/personal-website/api/
